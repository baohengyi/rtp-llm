diff --git a/rtp_llm/flexlb/flexlb-common/src/main/java/org/flexlb/config/FlexlbConfigMigration.java b/rtp_llm/flexlb/flexlb-common/src/main/java/org/flexlb/config/FlexlbConfigMigration.java
