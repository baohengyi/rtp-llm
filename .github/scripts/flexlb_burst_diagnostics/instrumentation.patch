+package org.flexlb.balance.diagnostic;
+import java.util.*;
+import java.util.concurrent.ConcurrentLinkedQueue;
+import java.nio.file.*;
+public final class RouteStageProbe {
+    private static final java.lang.management.ThreadMXBean CPU = java.lang.management.ManagementFactory.getThreadMXBean();
+    public static long cpu() { return CPU.getCurrentThreadCpuTime(); }
+    private static final ConcurrentLinkedQueue<Map<String, Values>> ALL = new ConcurrentLinkedQueue<>();
+    private static final ThreadLocal<Map<String, Values>> LOCAL = ThreadLocal.withInitial(() -> {
+        Map<String, Values> m = new HashMap<>(); ALL.add(m); return m;
+    });
+    static { Runtime.getRuntime().addShutdownHook(new Thread(RouteStageProbe::dump)); }
+    private static final class Values {
+        long[] values = new long[128]; int size;
+        void add(long n) { if (size == values.length) values = Arrays.copyOf(values, size * 2); values[size++] = n; }
+    }
+    public static void add(String name, long value) { LOCAL.get().computeIfAbsent(name, k -> new Values()).add(value); }
+    private static void dump() {
+        try {
+            Map<String, Values> merged = new TreeMap<>();
+            for (var thread : ALL) for (var entry : thread.entrySet()) {
+                var dest = merged.computeIfAbsent(entry.getKey(), k -> new Values()); var from = entry.getValue();
+                for (int i = 0; i < from.size; i++) dest.add(from.values[i]);
+            }
+            StringJoiner json = new StringJoiner(",\n", "{\n", "\n}\n");
+            for (var e : merged.entrySet()) {
+                var v = e.getValue(); long[] a = Arrays.copyOf(v.values, v.size); Arrays.sort(a);
+                long sum = 0; for (long n : a) sum += n;
+                json.add("\"" + e.getKey() + "\":{\"count\":" + a.length + ",\"sum\":" + sum
+                    + ",\"min\":" + a[0] + ",\"p50\":" + a[(a.length - 1) / 2]
+                    + ",\"p90\":" + a[(int)Math.ceil(a.length * .90) - 1]
+                    + ",\"p99\":" + a[(int)Math.ceil(a.length * .99) - 1] + ",\"max\":" + a[a.length - 1] + "}");
+            }
+            Files.writeString(Path.of(System.getProperty("route.stage.probe.output")), json.toString());
+        } catch (Exception e) { e.printStackTrace(); }
+    }
+}
